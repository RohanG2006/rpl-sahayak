# Copy to backend/.env  — never commit real keys. The frontend never sees these values.
DATABASE_URL=postgresql+psycopg://rpl:rpl@localhost:5433/rpl_sahayak
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# AI provider: mock (default, deterministic, offline) | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Send evidence images to the real provider (false = metadata-only analysis, labelled simulated)
AI_SEND_EVIDENCE=false
MAX_UPLOAD_MB=15
DEMO_MODE_ENABLED=true
# Mapping weights (spec §10)
MATCH_W_SKILL=0.40
MATCH_W_TASK=0.25
MATCH_W_EXPERIENCE=0.15
MATCH_W_OCCUPATION=0.10
MATCH_W_ELIGIBILITY=0.10
# frontend/.env.local
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
